{
  "name": "@thomasfosterau/effect-wikimedia",
  "version": "0.3.0",
  "description": "A strongly typed, Effect-idiomatic client family for Wikimedia properties — Wikipedia, Wikidata, Commons, WDQS, wikitext, and dumps.",
  "keywords": [
    "commons",
    "effect",
    "functional-programming",
    "mediawiki",
    "sparql",
    "typescript",
    "wikidata",
    "wikimedia",
    "wikipedia",
    "wikitext"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-wikimedia#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-wikimedia/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-wikimedia.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prepare": "effect-tsgo patch --typescript",
    "changeset": "changeset",
    "version": "changeset version && vp fmt",
    "release": "vp run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
