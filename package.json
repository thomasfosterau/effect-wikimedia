{
  "name": "@thomasfosterau/effect-wikimedia",
  "version": "0.11.0",
  "description": "A strongly typed, Effect-idiomatic client family for Wikimedia properties — Wikipedia, Wikidata, Commons, WDQS, wikitext, and dumps.",
  "keywords": [
    "commons",
    "effect",
    "functional-programming",
    "mediawiki",
    "sparql",
    "typescript",
    "wikidata",
    "wikimedia",
    "wikipedia",
    "wikitext"
  ],
  "homepage": "https://www.npmjs.com/package/@thomasfosterau/effect-wikimedia",
  "bugs": {
    "email": "me@thomasfoster.au"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-wikimedia.git"
  },
  "files": [
    "dist",
    "README.md",
    "docs/dumps.md",
    "docs/requests.md",
    "docs/typescript.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Action": {
      "types": "./dist/action.d.ts",
      "import": "./dist/action.js"
    },
    "./Commons": {
      "types": "./dist/commons.d.ts",
      "import": "./dist/commons.js"
    },
    "./Core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./Dumps": {
      "types": "./dist/dumps/index.d.ts",
      "import": "./dist/dumps/index.js"
    },
    "./Reconciliation": {
      "types": "./dist/reconciliation/index.d.ts",
      "import": "./dist/reconciliation/index.js"
    },
    "./Rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js"
    },
    "./Sparql": {
      "types": "./dist/sparql.d.ts",
      "import": "./dist/sparql.js"
    },
    "./Wikidata": {
      "types": "./dist/wikidata.d.ts",
      "import": "./dist/wikidata.js"
    },
    "./Wikitext": {
      "types": "./dist/wikitext/index.d.ts",
      "import": "./dist/wikitext/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint --tsrs"
  },
  "dependencies": {
    "@thomasfosterau/effect-parse": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@types/unbzip2-stream": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "fallow": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "unbzip2-stream": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0"
}
