{
  "name": "@thomasfosterau/effect-wikimedia",
  "version": "1.0.0",
  "description": "A strongly typed, Effect-idiomatic client family for Wikimedia properties — Wikipedia, Wikidata, Commons, WDQS, wikitext, and dumps.",
  "keywords": [
    "commons",
    "effect",
    "functional-programming",
    "mediawiki",
    "sparql",
    "typescript",
    "wikidata",
    "wikimedia",
    "wikipedia",
    "wikitext"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-wikimedia#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-wikimedia/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-wikimedia.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prepare": "effect-language-service patch",
    "changeset": "changeset",
    "version": "changeset version && vp fmt",
    "release": "vp run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/language-service": "^0.87.0",
    "@types/node": "^26.1.2",
    "effect": "4.0.0-beta.107",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
