{
  // The dist-consumer declaration check (`vp run check:dist`, #20): type-checks
  // `index.ts` the way a consumer's compiler sees the PUBLISHED package — the
  // emitted `dist/*.d.ts`, reached through package.json `exports` — so broken
  // declarations fail CI even when the source type-check passes. Run it after
  // `vp run build`; without `dist/` the import does not resolve.
  //
  // Deliberately NOT extending ../../tsconfig.json: a consumer has none of the
  // repo's source-only flags (`allowImportingTsExtensions`, the Effect
  // language-service plugin), and the root config excludes this directory.
  "compilerOptions": {
    "target": "ES2022",
    // A browser consumer's lib, and what effect's own declarations need:
    // `DOM` for the web types they name, `ESNext.Disposable` for `Disposable`
    // / `AsyncDisposable` (`ES2025` or later also has them). The package's
    // own declarations need nothing beyond `ES2022`.
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    // `nodenext` is the strictest consumer resolution: it requires the `types`
    // condition in `exports` and explicit `.js` extensions on every relative
    // specifier inside the emitted declarations. A `bundler` consumer accepts
    // everything `nodenext` does.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // No `@types/node`, as in a browser or Worker project: the published
    // declarations must not need Node's types (#73). The `Dumps` byte sources
    // run on Node but type their streams structurally, and the build is
    // `platform: "neutral"`; a `Buffer`, `NodeJS.*` or `node:*` type leaking
    // into a declaration fails this check.
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    // The point of the check: type-check the published `.d.ts` files
    // themselves, not just this file's uses of them.
    "skipLibCheck": false,
    "isolatedModules": true
  },
  "files": ["index.ts"]
}
