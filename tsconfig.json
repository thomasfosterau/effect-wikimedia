{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // TypeScript 6+ no longer auto-includes every `@types/*` package.
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Sources import siblings with an explicit `.ts` extension (`./core.ts`),
    // which is what Node's own resolver wants and what keeps the modules
    // runnable as raw TypeScript. `allowImportingTsExtensions` permits it under
    // `noEmit`; `rewriteRelativeImportExtensions` rewrites the specifier to
    // `.js` for anything that does emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // `noImplicitReturns` is deliberately off. The Wikitext walker's visitor is
    // typed `(node: Node) => boolean | void` — returning `false` skips a
    // subtree and falling off the end means "descend" — so callers are meant to
    // return on some paths and not others.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // A "warning" fails the patched native `tsc` by default; this flag
        // keeps Effect warnings visible but non-blocking, as in the sibling
        // library repos.
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          // Effect 4 marks much of `effect/http` `@stability unstable`, so as
          // a warning this fires on every HTTP client use and drowns the
          // warnings that matter. Owner decision (#26): a suggestion.
          "unstableApiUsage": "suggestion"
        }
      }
    ]
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts"],
  // `tests/dist-consumer/` type-checks against the built `dist/` under its own
  // tsconfig (`vp run check:dist`), not against `src/`.
  "exclude": ["node_modules", "dist", "tests/dist-consumer"]
}
